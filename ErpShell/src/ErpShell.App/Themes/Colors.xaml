<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand -->
    <Color x:Key="BrandPrimary">#4F46E5</Color>
    <Color x:Key="BrandPrimaryHover">#4338CA</Color>
    <Color x:Key="BrandPrimaryPressed">#3730A3</Color>
    <Color x:Key="BrandAccent">#06B6D4</Color>

    <!-- Semantic -->
    <Color x:Key="Success">#10B981</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="Danger">#EF4444</Color>
    <Color x:Key="Info">#3B82F6</Color>

    <!-- Light surfaces -->
    <Color x:Key="Surface0Light">#FFFFFF</Color>
    <Color x:Key="Surface1Light">#F8FAFC</Color>
    <Color x:Key="Surface2Light">#F1F5F9</Color>
    <Color x:Key="Surface3Light">#E2E8F0</Color>
    <Color x:Key="BorderLight">#E5E7EB</Color>
    <Color x:Key="DividerLight">#EEF2F6</Color>

    <!-- Light text -->
    <Color x:Key="TextPrimaryLight">#0F172A</Color>
    <Color x:Key="TextSecondaryLight">#475569</Color>
    <Color x:Key="TextTertiaryLight">#94A3B8</Color>
    <Color x:Key="TextInverseLight">#FFFFFF</Color>

    <!-- Dark surfaces -->
    <Color x:Key="Surface0Dark">#0B1220</Color>
    <Color x:Key="Surface1Dark">#0F172A</Color>
    <Color x:Key="Surface2Dark">#111B30</Color>
    <Color x:Key="Surface3Dark">#1E293B</Color>
    <Color x:Key="BorderDark">#1F2A44</Color>
    <Color x:Key="DividerDark">#172033</Color>

    <!-- Dark text -->
    <Color x:Key="TextPrimaryDark">#F8FAFC</Color>
    <Color x:Key="TextSecondaryDark">#CBD5E1</Color>
    <Color x:Key="TextTertiaryDark">#64748B</Color>

</ResourceDictionary>
