<UserControl x:Class="ErpShell.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface1Brush}">

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayTextStyle}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,16">
                <StackPanel>
                    <TextBlock Text="월별 매출 추이" Style="{StaticResource H3TextStyle}"/>
                    <TextBlock Text="최근 12개월" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,18"/>

                    <!-- Simple bar chart mockup -->
                    <Grid Height="220">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" Fill="{DynamicResource BrandBrush}"      Height="70"  Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                        <Rectangle Grid.Column="1" Fill="{DynamicResource BrandBrush}"      Height="95"  Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                        <Rectangle Grid.Column="2" Fill="{DynamicResource BrandBrush}"      Height="80"  Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                        <Rectangle Grid.Column="3" Fill="{DynamicResource BrandBrush}"      Height="120" Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                        <Rectangle Grid.Column="4" Fill="{DynamicResource BrandBrush}"      Height="140" Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                        <Rectangle Grid.Column="5" Fill="{DynamicResource BrandBrush}"      Height="110" Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                        <Rectangle Grid.Column="6" Fill="{DynamicResource BrandBrush}"      Height="155" Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                        <Rectangle Grid.Column="7" Fill="{DynamicResource BrandBrush}"      Height="125" Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                        <Rectangle Grid.Column="8" Fill="{DynamicResource BrandBrush}"      Height="170" Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                        <Rectangle Grid.Column="9" Fill="{DynamicResource BrandBrush}"      Height="160" Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                        <Rectangle Grid.Column="10" Fill="{DynamicResource BrandBrush}"     Height="185" Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                        <Rectangle Grid.Column="11" Fill="{DynamicResource BrandAccentBrush}" Height="210" Margin="6,0" VerticalAlignment="Bottom" RadiusX="4" RadiusY="4"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="카테고리별 매출 비중" Style="{StaticResource H3TextStyle}"/>
                    <TextBlock Text="이번 분기" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,18"/>

                    <StackPanel>
                        <Grid Margin="0,4,0,10">
                            <TextBlock Text="디스플레이"  Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="38%" HorizontalAlignment="Right" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Height="6" Background="{DynamicResource Surface2Brush}" CornerRadius="999" Margin="0,0,0,12">
                            <Border Width="240" Height="6" HorizontalAlignment="Left" Background="{DynamicResource BrandBrush}" CornerRadius="999"/>
                        </Border>

                        <Grid Margin="0,4,0,10">
                            <TextBlock Text="네트워크"    Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="24%" HorizontalAlignment="Right" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Height="6" Background="{DynamicResource Surface2Brush}" CornerRadius="999" Margin="0,0,0,12">
                            <Border Width="150" Height="6" HorizontalAlignment="Left" Background="{DynamicResource BrandAccentBrush}" CornerRadius="999"/>
                        </Border>

                        <Grid Margin="0,4,0,10">
                            <TextBlock Text="주변기기"    Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="22%" HorizontalAlignment="Right" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Height="6" Background="{DynamicResource Surface2Brush}" CornerRadius="999" Margin="0,0,0,12">
                            <Border Width="140" Height="6" HorizontalAlignment="Left" Background="{DynamicResource InfoBrush}" CornerRadius="999"/>
                        </Border>

                        <Grid Margin="0,4,0,10">
                            <TextBlock Text="스토리지"    Style="{StaticResource SecondaryTextStyle}"/>
                            <TextBlock Text="16%" HorizontalAlignment="Right" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                        </Grid>
                        <Border Height="6" Background="{DynamicResource Surface2Brush}" CornerRadius="999">
                            <Border Width="100" Height="6" HorizontalAlignment="Left" Background="{DynamicResource SuccessBrush}" CornerRadius="999"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="리포트 라이브러리" Style="{StaticResource H3TextStyle}"/>
                    <TextBlock Text="자주 사용하는 리포트를 빠르게 실행하세요."
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,2,0,18"/>
                    <WrapPanel>
                        <Border Width="220" Padding="14" Margin="0,0,12,12"
                                CornerRadius="12"
                                Background="{DynamicResource Surface2Brush}">
                            <StackPanel>
                                <TextBlock Text="손익 계산서" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="월/분기/연간 비교 분석" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Width="220" Padding="14" Margin="0,0,12,12"
                                CornerRadius="12"
                                Background="{DynamicResource Surface2Brush}">
                            <StackPanel>
                                <TextBlock Text="현금 흐름표" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="영업·투자·재무활동 요약" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Width="220" Padding="14" Margin="0,0,12,12"
                                CornerRadius="12"
                                Background="{DynamicResource Surface2Brush}">
                            <StackPanel>
                                <TextBlock Text="재고 회전율" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="품목·창고별 회전 지표" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Width="220" Padding="14" Margin="0,0,12,12"
                                CornerRadius="12"
                                Background="{DynamicResource Surface2Brush}">
                            <StackPanel>
                                <TextBlock Text="채권 연령 분석" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}"/>
                                <TextBlock Text="고객사별 미수금 추적" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
