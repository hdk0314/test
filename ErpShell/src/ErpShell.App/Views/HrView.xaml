<UserControl x:Class="ErpShell.App.Views.HrView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ErpShell.App.Converters"
             Background="{DynamicResource Surface1Brush}">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusBrush"/>
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayTextStyle}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Content="조직도 보기"/>
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="+ 직원 등록"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid Style="{StaticResource ModernDataGridStyle}"
                      ItemsSource="{Binding Employees}"
                      Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="사번"      Binding="{Binding EmployeeNo}" Width="100"/>
                    <DataGridTextColumn Header="이름"      Binding="{Binding Name}"       Width="120"/>
                    <DataGridTextColumn Header="부서"      Binding="{Binding Department}" Width="140"/>
                    <DataGridTextColumn Header="직급"      Binding="{Binding Position}"   Width="100"/>
                    <DataGridTextColumn Header="이메일"    Binding="{Binding Email}"      Width="*"/>
                    <DataGridTextColumn Header="입사일"    Binding="{Binding HireDate, StringFormat=yyyy.MM.dd}" Width="120"/>
                    <DataGridTemplateColumn Header="상태"  Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
