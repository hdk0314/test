<UserControl x:Class="ErpShell.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Surface1Brush}">

    <ScrollViewer>
        <Grid Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayTextStyle}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Profile -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="회사 정보" Style="{StaticResource H3TextStyle}"/>
                    <TextBlock Text="조직 기본 정보를 관리합니다."
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,2,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="회사명" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="이메일" Style="{StaticResource CaptionTextStyle}"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="외관" Style="{StaticResource H3TextStyle}"/>
                    <TextBlock Text="라이트/다크 테마를 선택하세요."
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,2,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="현재 테마" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0">
                                <Run Text="현재 적용된 테마:"/>
                                <Run Text="{Binding IsDark, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ToggleThemeCommand}"
                                Content="테마 전환"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="알림" Style="{StaticResource H3TextStyle}"/>
                    <TextBlock Text="이벤트가 발생하면 어떻게 알림을 받을지 선택하세요."
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="0,2,0,18"/>

                    <CheckBox IsChecked="{Binding EmailNotifications}"
                              Content="이메일 알림 받기"
                              FontFamily="{StaticResource FontPrimary}"
                              FontSize="{StaticResource FontSizeBody}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Margin="0,0,0,10"/>

                    <CheckBox IsChecked="{Binding DesktopNotifications}"
                              Content="데스크톱 알림 받기"
                              FontFamily="{StaticResource FontPrimary}"
                              FontSize="{StaticResource FontSizeBody}"
                              Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
