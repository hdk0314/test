<UserControl x:Class="ErpShell.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ErpShell.App.Converters"
             xmlns:views="clr-namespace:ErpShell.App.Views"
             Background="{DynamicResource Surface1Brush}">

    <UserControl.Resources>
        <conv:BoolToBrushConverter x:Key="UpDownBrush">
            <conv:BoolToBrushConverter.TrueBrush>
                <SolidColorBrush Color="{StaticResource Success}"/>
            </conv:BoolToBrushConverter.TrueBrush>
            <conv:BoolToBrushConverter.FalseBrush>
                <SolidColorBrush Color="{StaticResource Danger}"/>
            </conv:BoolToBrushConverter.FalseBrush>
        </conv:BoolToBrushConverter>
        <conv:StatusToBrushConverter x:Key="StatusBrush"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayTextStyle}"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Content="내보내기"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="보고서 생성"/>
                </StackPanel>
            </Grid>

            <!-- KPI Cards -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Kpis}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource SecondaryTextStyle}"/>
                                    <Border Width="34" Height="34"
                                            HorizontalAlignment="Right"
                                            CornerRadius="10"
                                            Background="{DynamicResource Surface2Brush}">
                                        <Path Width="18" Height="18"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource BrandBrush}"
                                              StrokeThickness="1.6"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Fill="Transparent"
                                              Data="{Binding IconResourceKey, Converter={x:Static views:IconConverter.Instance}}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Value}"
                                           Style="{StaticResource H2TextStyle}"
                                           Margin="0,16,0,8"/>

                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Border Background="{DynamicResource Surface2Brush}"
                                            CornerRadius="999"
                                            Padding="8,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="10" Height="10"
                                                  Margin="0,0,4,0"
                                                  Stretch="Uniform"
                                                  VerticalAlignment="Center"
                                                  Stroke="{Binding IsPositive, Converter={StaticResource UpDownBrush}}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"
                                                  Fill="Transparent">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="{StaticResource IconArrowUp}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPositive}" Value="False">
                                                                <Setter Property="Data" Value="{StaticResource IconArrowDown}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                            <TextBlock Text="{Binding Delta}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding IsPositive, Converter={StaticResource UpDownBrush}}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="전월 대비"
                                               Style="{StaticResource CaptionTextStyle}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recent + Quick info -->
            <Grid Grid.Row="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recent orders -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="20,18,20,14">
                            <StackPanel>
                                <TextBlock Text="최근 주문" Style="{StaticResource H3TextStyle}"/>
                                <TextBlock Text="이번 주 등록된 영업 주문 내역"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Content="전체 보기"/>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  ItemsSource="{Binding RecentOrders}"
                                  Margin="8,0,8,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="주문번호" Binding="{Binding OrderNo}" Width="140"/>
                                <DataGridTextColumn Header="고객사"   Binding="{Binding Customer}" Width="*"/>
                                <DataGridTextColumn Header="품목"     Binding="{Binding Item}" Width="*"/>
                                <DataGridTextColumn Header="수량"     Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="금액"     Binding="{Binding Amount, StringFormat=₩ {0:N0}}" Width="140"/>
                                <DataGridTemplateColumn Header="상태" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Side card -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="이번 달 진행 상황" Style="{StaticResource H3TextStyle}"/>
                        <TextBlock Text="목표 대비 실적 요약"
                                   Style="{StaticResource CaptionTextStyle}"
                                   Margin="0,2,0,16"/>

                        <StackPanel Margin="0,4,0,12">
                            <Grid>
                                <TextBlock Text="매출 목표"
                                           Style="{StaticResource SecondaryTextStyle}"/>
                                <TextBlock Text="78%"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource BodyTextStyle}"
                                           FontWeight="SemiBold"/>
                            </Grid>
                            <Border Height="6"
                                    Margin="0,6,0,0"
                                    Background="{DynamicResource Surface2Brush}"
                                    CornerRadius="999">
                                <Border Width="240" Height="6"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource BrandBrush}"
                                        CornerRadius="999"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,12">
                            <Grid>
                                <TextBlock Text="수금률"
                                           Style="{StaticResource SecondaryTextStyle}"/>
                                <TextBlock Text="64%"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource BodyTextStyle}"
                                           FontWeight="SemiBold"/>
                            </Grid>
                            <Border Height="6"
                                    Margin="0,6,0,0"
                                    Background="{DynamicResource Surface2Brush}"
                                    CornerRadius="999">
                                <Border Width="200" Height="6"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource BrandAccentBrush}"
                                        CornerRadius="999"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Margin="0,4,0,12">
                            <Grid>
                                <TextBlock Text="재고 안전도"
                                           Style="{StaticResource SecondaryTextStyle}"/>
                                <TextBlock Text="92%"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource BodyTextStyle}"
                                           FontWeight="SemiBold"/>
                            </Grid>
                            <Border Height="6"
                                    Margin="0,6,0,0"
                                    Background="{DynamicResource Surface2Brush}"
                                    CornerRadius="999">
                                <Border Width="280" Height="6"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource SuccessBrush}"
                                        CornerRadius="999"/>
                            </Border>
                        </StackPanel>

                        <Border Margin="0,20,0,0"
                                Padding="14"
                                CornerRadius="12"
                                Background="{DynamicResource Surface2Brush}">
                            <StackPanel>
                                <TextBlock Text="요청 처리 대기" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold"/>
                                <TextBlock Text="6건의 결재가 승인을 기다리고 있습니다."
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,4,0,10"
                                           TextWrapping="Wrap"/>
                                <Button Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Content="확인하기"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
