<UserControl x:Class="ErpShell.App.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ErpShell.App.Converters"
             Background="{DynamicResource Surface1Brush}">

    <UserControl.Resources>
        <conv:StatusToBrushConverter x:Key="StatusBrush"/>
    </UserControl.Resources>

    <Grid Margin="32,28,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayTextStyle}"/>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0" Content="가져오기"/>
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="+ 신규 주문"/>
            </StackPanel>
        </Grid>

        <!-- Filter bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource Surface0Brush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Border Background="{DynamicResource BrandBrush}" CornerRadius="999" Padding="10,4" Margin="0,0,6,0">
                    <TextBlock Text="전체" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                </Border>
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="999" Padding="10,4" Margin="0,0,6,0">
                    <TextBlock Text="신규" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="999" Padding="10,4" Margin="0,0,6,0">
                    <TextBlock Text="확정" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="999" Padding="10,4" Margin="0,0,6,0">
                    <TextBlock Text="출고대기" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="999" Padding="10,4">
                    <TextBlock Text="완료" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Table -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <DataGrid Style="{StaticResource ModernDataGridStyle}"
                      ItemsSource="{Binding Orders}"
                      Margin="8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="주문번호"  Binding="{Binding OrderNo}"  Width="140"/>
                    <DataGridTextColumn Header="고객사"    Binding="{Binding Customer}" Width="*"/>
                    <DataGridTextColumn Header="품목"      Binding="{Binding Item}"     Width="*"/>
                    <DataGridTextColumn Header="수량"      Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="금액"      Binding="{Binding Amount, StringFormat=₩ {0:N0}}" Width="160"/>
                    <DataGridTextColumn Header="주문일자"  Binding="{Binding OrderDate, StringFormat=yyyy.MM.dd}" Width="120"/>
                    <DataGridTemplateColumn Header="상태"  Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,6,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
