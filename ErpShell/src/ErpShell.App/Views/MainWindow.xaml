<Window x:Class="ErpShell.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ErpShell.App.ViewModels"
        xmlns:views="clr-namespace:ErpShell.App.Views"
        xmlns:conv="clr-namespace:ErpShell.App.Converters"
        xmlns:cm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="ErpShell"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        Background="{DynamicResource Surface1Brush}">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>

        <CollectionViewSource x:Key="GroupedNav" Source="{Binding NavItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <!-- View 매핑 -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HrViewModel}">
            <views:HrView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountingViewModel}">
            <views:AccountingView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>

        <!-- Nav Item Template -->
        <Style x:Key="NavListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Path x:Name="Icon" Grid.Column="0"
                                      Width="20" Height="20"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Data="{Binding IconResourceKey,
                                             Converter={x:Static views:IconConverter.Instance}}"/>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextInverseBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource Surface1Brush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- =================== Sidebar =================== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,24,22,18">
                        <Border Width="36" Height="36"
                                CornerRadius="10"
                                Background="{DynamicResource BrandBrush}">
                            <TextBlock Text="E"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ErpShell"
                                       Style="{StaticResource H3TextStyle}"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Enterprise Suite"
                                       Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Nav -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Source={StaticResource GroupedNav}}"
                             SelectedItem="{Binding SelectedNav}"
                             ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   FontWeight="SemiBold"
                                                   Margin="22,18,22,6"/>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <!-- User card -->
                    <Border Grid.Row="2"
                            Margin="14"
                            Padding="12"
                            CornerRadius="12"
                            Background="{DynamicResource Surface2Brush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    CornerRadius="999"
                                    Background="{DynamicResource BrandAccentBrush}">
                                <TextBlock Text="K"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserName}"
                                           Style="{StaticResource BodyTextStyle}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding UserRole}"
                                           Style="{StaticResource CaptionTextStyle}"/>
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding ToggleThemeCommand}"
                                    ToolTip="테마 전환">
                                <Path Width="18" Height="18"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Data="{StaticResource IconMoon}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- =================== Main =================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top bar -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Surface0Brush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <Border Grid.Column="0"
                                MaxWidth="520"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="10"
                                Background="{DynamicResource Surface1Brush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                Padding="10,0">
                            <Grid Height="38">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0"
                                      Width="16" Height="16"
                                      Margin="6,0,8,0"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TextTertiaryBrush}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      Data="{StaticResource IconSearch}"/>

                                <TextBox Grid.Column="1"
                                         Width="380"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"
                                         FontFamily="{StaticResource FontPrimary}"
                                         FontSize="{StaticResource FontSizeBody}"
                                         CaretBrush="{DynamicResource BrandBrush}"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Column="1"
                                           Margin="2,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Text="주문, 고객, 품목, 직원 검색…">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SearchText}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Border Grid.Column="2"
                                        Background="{DynamicResource Surface2Brush}"
                                        CornerRadius="4"
                                        Padding="6,2"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Ctrl + K"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14"
                                          Margin="0,0,6,0"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource TextPrimaryBrush}"
                                          StrokeThickness="1.8"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Data="{StaticResource IconPlus}"/>
                                    <TextBlock Text="새로 만들기"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="알림">
                                <Grid>
                                    <Path Width="20" Height="20"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"
                                          Data="{StaticResource IconBell}"/>
                                    <Border Width="8" Height="8"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,2,2,0"
                                            CornerRadius="999"
                                            Background="{DynamicResource DangerBrush}"/>
                                </Grid>
                            </Button>

                            <Border Width="1" Height="20" Margin="10,0"
                                    Background="{DynamicResource DividerBrush}"/>

                            <Border Width="36" Height="36"
                                    CornerRadius="999"
                                    Background="{DynamicResource BrandAccentBrush}">
                                <TextBlock Text="K"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <ContentControl Grid.Row="1"
                                Content="{Binding Current}"
                                Margin="0"
                                Focusable="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
